# ──────────────────────────────────────────────────────
#  Enterprise Knowledge Base — Environment Variables
#  Copy this file to .env and fill in the values
# ──────────────────────────────────────────────────────

# PostgreSQL
PG_USER=kb_user
PG_PASSWORD=changeme_strong_password

# MinIO (Milvus object storage)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# ─── AI Provider API Keys ─────────────────────────────
# MiniMax (default provider — fill this in)
MINIMAX_API_KEY=your_minimax_api_key_here

# Alibaba DashScope / Tongyi Qianwen (optional)
DASHSCOPE_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=

# ─── JWT Secret ───────────────────────────────────────
# Must be >= 32 characters.  Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-256-bit-secret-key

# ─── Redis ────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password

# ─── 在线 LLM Tracing → LangFuse (ADR-015) ────────────
# 总开关，默认关闭。开启后才装配 reactor 传播 / 脱敏 / 业务属性 SpanProcessor / 根 span，
# 并按采样比例采样；仅当 OTLP traces endpoint 就绪时才真正导出。
KB_TRACING_ENABLED=false
KB_TRACING_SAMPLE_RATIO=1.0
# 直连 LangFuse 的 trace-specific endpoint（docker 网络内）。留空则不导出。
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://langfuse-web:3000/api/public/otel/v1/traces
# OTLP Basic Auth：base64(public_key:secret_key)。生成：echo -n "pk-lf-xxx:sk-lf-xxx" | base64
LANGFUSE_OTLP_BASIC_AUTH=

# LangFuse 项目 API key（同时供 LANGFUSE_INIT_* 首次自举与上面的 Basic Auth 拼装）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 可选：首次启动自动创建组织/项目
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_PROJECT_ID=

# LangFuse 必需密钥（禁止使用示例默认值）。生成：
#   LANGFUSE_SALT / LANGFUSE_NEXTAUTH_SECRET: openssl rand -base64 32
#   LANGFUSE_ENCRYPTION_KEY: openssl rand -hex 32  (必须 64 位十六进制)
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_URL=http://localhost:3001
# LangFuse 复用现有实例：Redis 独立 db index、MinIO 独立 bucket
LANGFUSE_REDIS_DB=3
LANGFUSE_S3_BUCKET=langfuse

# ClickHouse（LangFuse trace 存储，新增容器）
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=changeme_clickhouse_password

# ─── Production only ──────────────────────────────────
REGISTRY=your-docker-registry.example.com
VERSION=latest
