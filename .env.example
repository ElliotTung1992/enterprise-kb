# ──────────────────────────────────────────────────────
#  Enterprise Knowledge Base — Environment Variables
#  Copy this file to .env and fill in the values
# ──────────────────────────────────────────────────────

# PostgreSQL
PG_USER=kb_user
PG_PASSWORD=changeme_strong_password

# MinIO (Milvus object storage)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# ─── AI Provider API Keys ─────────────────────────────
# llama.cpp local model
# 纯文本 Qwen3 原版混合权重（支持 /think·/no_think）；GGUF 名以 llama-server 加载为准。
# 「深度思考」要展示推理旁白，需以 --reasoning-format none 启动（<think> 内联进 content），见 docs/design-agentic-stream-process-events.md §6
LLAMA_CPP_BASE_URL=http://localhost:8079
LLAMA_CPP_MODEL=qwen3-14b
LLAMA_CPP_API_KEY=local

# Alibaba DashScope / Tongyi Qianwen (optional)
DASHSCOPE_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# ─── JWT Secret ───────────────────────────────────────
# Must be >= 32 characters.  Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-256-bit-secret-key

# ─── Redis ────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password

# ─── 用户画像与个性化问答 (ADR-016) ───────────────────
# Phase 1 在线注入开关（画像偏好注入问答 prompt），默认开
KB_PROFILE_INJECTION_ENABLED=true
# Phase 2 离线推断开关（Kafka + LLM 推断资历），默认关；开启需 Kafka 可用
KB_PROFILE_INFERENCE_ENABLED=false
# 应用连接 Kafka 的地址：docker 网络内为 kafka:9092，宿主本地开发为 localhost:29092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Kafka KRaft 集群 ID（首次格式化用，保持稳定）
KAFKA_CLUSTER_ID=kb-kafka-cluster-00001

# ─── 在线 LLM Tracing → LangFuse (ADR-015) ────────────
# 是否启用在线 tracing；true 时会装配 Micrometer/OTel、脱敏过滤、业务根 span 与上下文传播。
KB_TRACING_ENABLED=false
# tracing 采样比例；1.0 表示全量采样，生产可按负载下调。
KB_TRACING_SAMPLE_RATIO=1.0
# 直连 LangFuse 的 trace-specific endpoint（docker 网络内）。留空则不导出。
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://langfuse-web:3000/api/public/otel/v1/traces
# OTLP Basic Auth：base64(public_key:secret_key)。生成：echo -n "pk-lf-xxx:sk-lf-xxx" | base64
LANGFUSE_OTLP_BASIC_AUTH=

# LangFuse 项目 public key；同时用于首次自举项目 key 与 OTLP Basic Auth 拼装。
LANGFUSE_PUBLIC_KEY=
# LangFuse 项目 secret key；同时用于首次自举项目 key 与 OTLP Basic Auth 拼装。
LANGFUSE_SECRET_KEY=

# ─── LangFuse Prompt 管理 (ADR-017) ───────────────────
# 是否启用 LangFuse prompt 热更新；默认 false，关闭时只读 classpath fallback。
KB_PROMPT_ENABLED=false
# 拉取 prompt 使用的 label。预发可设 staging，生产默认 production。
KB_PROMPT_LABEL=production
# prompt 缓存刷新周期与兜底缓存过期时间。
KB_PROMPT_CACHE_TTL=60s
KB_PROMPT_CACHE_EXPIRE=24h
KB_PROMPT_CACHE_MAXIMUM_SIZE=100
# SDK 单次 prompt fetch timeout 与重试次数；主链路优先低延迟。
KB_PROMPT_CLIENT_TIMEOUT=3s
KB_PROMPT_CLIENT_MAX_RETRIES=0
# LangFuse 自部署 base URL；docker 网络内默认 langfuse-web。
LANGFUSE_BASE_URL=http://langfuse-web:3000
# 可选：首次启动自动创建组织、项目、项目 API key 与登录用户。
# 若只想通过 UI 手动注册，可保留这些 LANGFUSE_INIT_* 为空。
# LangFuse 首次启动自动创建的组织 ID。
LANGFUSE_INIT_ORG_ID=
# LangFuse 首次启动自动创建的组织名称。
LANGFUSE_INIT_ORG_NAME=
# LangFuse 首次启动自动创建的项目 ID。
LANGFUSE_INIT_PROJECT_ID=
# LangFuse 首次启动自动创建的项目名称。
LANGFUSE_INIT_PROJECT_NAME=
# LangFuse 首次启动自动创建的登录用户邮箱。
LANGFUSE_INIT_USER_EMAIL=
# LangFuse 首次启动自动创建的登录用户显示名。
LANGFUSE_INIT_USER_NAME=
# LangFuse 首次启动自动创建的登录用户密码。
LANGFUSE_INIT_USER_PASSWORD=

# LangFuse 必需密钥（禁止使用示例默认值）。生成：
#   LANGFUSE_SALT / LANGFUSE_NEXTAUTH_SECRET: openssl rand -base64 32
#   LANGFUSE_ENCRYPTION_KEY: openssl rand -hex 32  (必须 64 位十六进制)
# LangFuse 服务端 salt，用于内部哈希/加盐；使用场景：生成/校验内部 token、密钥哈希等不可逆摘要时混入该值，降低撞库和反推风险。生产环境必须重新生成并保持稳定。
LANGFUSE_SALT=
# LangFuse NextAuth 会话签名密钥；使用场景：签名/校验 Web 登录会话、CSRF/state 等认证相关 token，防止会话被伪造。生产环境必须重新生成并保持稳定，随意更换会导致现有登录会话失效。
LANGFUSE_NEXTAUTH_SECRET=
# LangFuse 数据加密密钥，必须为 64 位十六进制字符串；使用场景：加密存储集成配置、API key、blob storage secret 等可解密敏感数据。生产环境必须重新生成，已有数据写入后不要随意更换。
LANGFUSE_ENCRYPTION_KEY=
# LangFuse Web 对外访问地址，用于登录回调和页面链接。
LANGFUSE_NEXTAUTH_URL=http://localhost:3001
# LangFuse 复用 Redis 时使用的独立 DB index，避免和应用缓存混在一起。
LANGFUSE_REDIS_DB=3
# LangFuse 复用 MinIO 时使用的独立 bucket 名称。
LANGFUSE_S3_BUCKET=langfuse

# ClickHouse（LangFuse trace 存储，新增容器）
# ClickHouse 用户名，供 LangFuse 存储 traces/observations。
CLICKHOUSE_USER=clickhouse
# ClickHouse 密码，供 LangFuse 连接 trace 存储。
CLICKHOUSE_PASSWORD=changeme_clickhouse_password

# ─── Production only ──────────────────────────────────
REGISTRY=your-docker-registry.example.com
VERSION=latest
