<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.enterprise.kb.document.mapper.MdParentChunkMapper">

    <resultMap id="MdParentChunkResultMap" type="com.enterprise.kb.document.model.MdParentChunk">
        <id property="id" column="id"/>
        <result property="documentId" column="document_id"/>
        <result property="spaceId" column="space_id"/>
        <result property="section" column="section"/>
        <result property="headingLevel" column="heading_level"/>
        <result property="content" column="content"/>
        <result property="ordinal" column="ordinal"/>
        <result property="childCount" column="child_count"/>
        <result property="charStart" column="char_start"/>
        <result property="charEnd" column="char_end"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insertBatch">
        INSERT INTO md_parent_chunk (
            id, document_id, space_id, section, heading_level, content,
            ordinal, child_count, char_start, char_end, created_at
        ) VALUES
        <foreach collection="list" item="chunk" separator=",">
            (
                #{chunk.id,jdbcType=OTHER},
                #{chunk.documentId,jdbcType=OTHER},
                #{chunk.spaceId,jdbcType=OTHER},
                #{chunk.section},
                #{chunk.headingLevel},
                #{chunk.content},
                #{chunk.ordinal},
                #{chunk.childCount},
                #{chunk.charStart},
                #{chunk.charEnd},
                #{chunk.createdAt}
            )
        </foreach>
    </insert>

    <select id="findById" resultMap="MdParentChunkResultMap">
        SELECT * FROM md_parent_chunk WHERE id = #{id,jdbcType=OTHER} LIMIT 1
    </select>

    <select id="findByIds" resultMap="MdParentChunkResultMap">
        SELECT * FROM md_parent_chunk
        WHERE id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id,jdbcType=OTHER}
        </foreach>
        ORDER BY ordinal ASC
    </select>

    <delete id="deleteByDocumentId">
        DELETE FROM md_parent_chunk WHERE document_id = #{documentId,jdbcType=OTHER}
    </delete>

    <delete id="deleteBySpaceId">
        DELETE FROM md_parent_chunk WHERE space_id = #{spaceId,jdbcType=OTHER}
    </delete>
</mapper>
