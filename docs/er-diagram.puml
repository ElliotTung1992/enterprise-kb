@startuml enterprise-kb-erd

' ────────────────────────────────────────────────────────
' 企业知识库 — 数据库 ER 图
' 生成自 db/changelog/001~016 迁移脚本
' ────────────────────────────────────────────────────────

left to right direction

skinparam linetype ortho
skinparam roundcorner 5
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 80
skinparam class {
    BackgroundColor #FAFAFA
    BorderColor     #888888
    ArrowColor      #555555
    HeaderBackgroundColor #4A90D9
    HeaderFontColor white
    FontName Helvetica
}

' ══════════════════════════════════════════════════════
' 列 1：基础用户体系
' ══════════════════════════════════════════════════════

together {
    entity "roles" as roles {
        * id              : UUID <<PK>>
        --
        * name            : VARCHAR(50) <<UNIQUE>>
          description     : TEXT
        * created_at      : TIMESTAMPTZ
    }

    entity "users" as users {
        * id              : UUID <<PK>>
        --
        * username        : VARCHAR(100) <<UNIQUE>>
        * email           : VARCHAR(255) <<UNIQUE>>
        * password_hash   : VARCHAR(255)
          full_name       : VARCHAR(255)
        * is_active       : BOOLEAN
        * created_at      : TIMESTAMPTZ
        * updated_at      : TIMESTAMPTZ
          deleted_at      : TIMESTAMPTZ
    }
}

' ══════════════════════════════════════════════════════
' 列 2：Token + 空间
' ══════════════════════════════════════════════════════

together {
    entity "refresh_tokens" as refresh_tokens {
        * id              : UUID <<PK>>
        --
        * user_id         : UUID <<FK>>
        * token_hash      : VARCHAR(255) <<UNIQUE>>
        * expires_at      : TIMESTAMPTZ
          revoked_at      : TIMESTAMPTZ
        * created_at      : TIMESTAMPTZ
    }

    entity "spaces" as spaces {
        * id                       : UUID <<PK>>
        --
        * name                     : VARCHAR(255)
        * slug                     : VARCHAR(100) <<UNIQUE>>
          description              : TEXT
        * owner_id                 : UUID <<FK>>
          preferred_model_provider : VARCHAR(30)
        * is_active                : BOOLEAN
        * created_at               : TIMESTAMPTZ
        * updated_at               : TIMESTAMPTZ
          deleted_at               : TIMESTAMPTZ
    }
}

' ══════════════════════════════════════════════════════
' 列 3：空间成员 + 文档 + 标签
' ══════════════════════════════════════════════════════

together {
    entity "user_space_roles" as user_space_roles {
        * id          : UUID <<PK>>
        --
        * user_id     : UUID <<FK>>
        * space_id    : UUID <<FK>>
        * role_type   : VARCHAR(20)
        * granted_at  : TIMESTAMPTZ
          granted_by  : UUID
        --
        <<UNIQUE (user_id, space_id, role_type)>>
    }

    entity "documents" as documents {
        * id                : UUID <<PK>>
        --
        * space_id          : UUID <<FK>>
          uploaded_by       : UUID
        * title             : VARCHAR(500)
        * original_filename : VARCHAR(500)
        * file_path         : TEXT
          file_size_bytes   : BIGINT
          mime_type         : VARCHAR(100)
          source_url        : TEXT
        * status            : VARCHAR(30)
          error_message     : TEXT
          chunk_count       : INTEGER
          language          : VARCHAR(20)
          metadata          : JSONB
        * created_at        : TIMESTAMPTZ
        * updated_at        : TIMESTAMPTZ
          deleted_at        : TIMESTAMPTZ
    }

    entity "tags" as tags {
        * id          : UUID <<PK>>
        --
        * space_id    : UUID <<FK>>
        * name        : VARCHAR(200)
        * slug        : VARCHAR(200)
          color       : VARCHAR(7)
          parent_id   : UUID <<FK, self>>
        * tag_type    : VARCHAR(50)
          description : TEXT
          sort_order  : INTEGER
        * created_at  : TIMESTAMPTZ
        * updated_at  : TIMESTAMPTZ
          deleted_at  : TIMESTAMPTZ
        --
        <<UNIQUE (space_id, slug)>>
    }
}

' ══════════════════════════════════════════════════════
' 列 4：文档子表
' ══════════════════════════════════════════════════════

together {
    entity "document_chunks" as document_chunks {
        * id              : UUID <<PK>>
        --
        * document_id     : UUID <<FK>>
        * chunk_index     : INTEGER
        * content         : TEXT
          token_count     : INTEGER
          milvus_id       : VARCHAR(100)
          embedding_model : VARCHAR(100)
          page_number     : INTEGER
          char_start      : INTEGER
          char_end        : INTEGER
        * created_at      : TIMESTAMPTZ
        --
        <<UNIQUE (document_id, chunk_index)>>
    }

    entity "document_tags" as document_tags {
        * id          : UUID <<PK>>
        --
        * document_id : UUID <<FK>>
        * tag_id      : UUID <<FK>>
          tagged_by   : UUID
          auto_tagged : BOOLEAN
          confidence  : NUMERIC(5,4)
        * created_at  : TIMESTAMPTZ
        --
        <<UNIQUE (document_id, tag_id)>>
    }

    entity "audit_logs" as audit_logs {
        * id            : UUID <<PK>>
        --
          user_id       : UUID
          space_id      : UUID
        * action        : VARCHAR(100)
          resource_type : VARCHAR(50)
          resource_id   : VARCHAR(100)
          ip_address    : INET
          user_agent    : TEXT
          payload       : JSONB
        * created_at    : TIMESTAMPTZ
    }
}

' ══════════════════════════════════════════════════════
' 列 5：文档关联 + 问答会话
' ══════════════════════════════════════════════════════

together {
    entity "document_relations" as document_relations {
        * id             : UUID <<PK>>
        --
        * source_doc_id  : UUID <<FK>>
        * target_doc_id  : UUID <<FK>>
        * relation_type  : VARCHAR(100)
          weight         : NUMERIC(5,4)
          auto_detected  : BOOLEAN
          created_by     : UUID
        * created_at     : TIMESTAMPTZ
        --
        <<UNIQUE (source_doc_id, target_doc_id, relation_type)>>
    }

    entity "qa_sessions" as qa_sessions {
        * id          : UUID <<PK>>
        --
        * space_id    : UUID <<FK>>
        * user_id     : UUID <<FK>>
        * title       : VARCHAR(200)
        * created_at  : TIMESTAMPTZ
        * updated_at  : TIMESTAMPTZ
          deleted_at  : TIMESTAMPTZ
        --
        <<IDX (space_id, user_id) WHERE deleted_at IS NULL>>
    }

    entity "qa_messages" as qa_messages {
        * id          : UUID <<PK>>
        --
        * session_id  : UUID <<FK>>
        * role        : VARCHAR(20)
        * content     : TEXT
        * created_at  : TIMESTAMPTZ
    }
}

' roles 无实际连线，锚定到 users 下方（同列）
users            -[hidden]down-   roles

' audit_logs 无实际连线，锚定到 document_tags 下方（同列）
document_tags    -[hidden]down-   audit_logs

' document_relations 锚定到 document_chunks / document_tags 右侧
document_chunks  -[hidden]right-  document_relations
document_tags    -[hidden]right-  document_relations

' qa 实体锚定到 document_relations 下方（同列）
document_relations -[hidden]down- qa_sessions
qa_sessions        -[hidden]down- qa_messages

' ══════════════════════════════════════════════════════
' 关系定义（按列从左到右，减少连线跨越）
' ══════════════════════════════════════════════════════

' 列1 → 列2
users           ||--o{  refresh_tokens     : "user_id"
users           ||--o{  spaces             : "owner_id"

' 列2 → 列3
users           ||--o{  user_space_roles   : "user_id"
spaces          ||--o{  user_space_roles   : "space_id"
spaces          ||--o{  documents          : "space_id"
spaces          ||--o{  tags               : "space_id"

' 列3 → 列4
documents       ||--o{  document_chunks    : "document_id"
documents       ||--o{  document_tags      : "document_id"
documents       ||--o{  document_relations : "source/target_doc_id"
tags            ||--o{  document_tags      : "tag_id"
tags            ||--o{  tags               : "parent_id (self)"

' 问答会话关系
users           ||--o{  qa_sessions        : "user_id"
spaces          ||--o{  qa_sessions        : "space_id"
qa_sessions     ||--o{  qa_messages        : "session_id"

@enduml
