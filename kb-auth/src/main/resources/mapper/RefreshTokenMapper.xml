<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.enterprise.kb.auth.mapper.RefreshTokenMapper">

    <resultMap id="RefreshTokenResultMap" type="com.enterprise.kb.auth.model.RefreshToken">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="tokenHash" column="token_hash"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="revokedAt" column="revoked_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByTokenHash" resultMap="RefreshTokenResultMap">
        SELECT * FROM refresh_tokens WHERE token_hash = #{tokenHash} LIMIT 1
    </select>

    <insert id="insert" useGeneratedKeys="false">
        INSERT INTO refresh_tokens (id, user_id, token_hash, expires_at, revoked_at, created_at)
        VALUES (
            #{id,jdbcType=OTHER},
            #{userId,jdbcType=OTHER},
            #{tokenHash},
            #{expiresAt},
            #{revokedAt},
            #{createdAt}
        )
    </insert>

    <update id="update">
        UPDATE refresh_tokens SET revoked_at = #{revokedAt}
        WHERE id = #{id,jdbcType=OTHER}
    </update>

    <update id="revokeAllByUserId">
        UPDATE refresh_tokens SET revoked_at = #{now}
        WHERE user_id = #{userId,jdbcType=OTHER} AND revoked_at IS NULL
    </update>

    <delete id="deleteExpired">
        DELETE FROM refresh_tokens WHERE expires_at &lt; #{cutoff}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM refresh_tokens WHERE user_id = #{userId,jdbcType=OTHER}
    </delete>

</mapper>
