<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.enterprise.kb.search.mapper.QaChatMessageMapper">

    <resultMap id="QaChatMessageResultMap" type="com.enterprise.kb.search.model.QaChatMessage">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="role" column="role"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findBySessionId" resultMap="QaChatMessageResultMap">
        SELECT * FROM qa_messages
        WHERE session_id = #{sessionId,jdbcType=OTHER}
        ORDER BY created_at ASC
    </select>

    <insert id="insert" useGeneratedKeys="false">
        INSERT INTO qa_messages (id, session_id, role, content, created_at)
        VALUES (
            #{id,jdbcType=OTHER},
            #{sessionId,jdbcType=OTHER},
            #{role},
            #{content},
            #{createdAt}
        )
    </insert>

</mapper>
